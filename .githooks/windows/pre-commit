#!/usr/bin/python
"""Start the staged scanner with native Python on Git for Windows."""

import runpy
import sys
from pathlib import Path


if sys.version_info < (3, 10):
    sys.exit("The pre-commit scanner requires Python 3.10 or later.")

sys.stdout.reconfigure(encoding="utf-8")
sys.stderr.reconfigure(encoding="utf-8")
scanner = str(Path("tools/check_secrets.py").resolve())
sys.argv = [scanner, "--staged"]
runpy.run_path(scanner, run_name="__main__")
